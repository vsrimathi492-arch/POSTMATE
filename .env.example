# ===================================================
# POSTMATE - Environment Configuration Example
# ===================================================
# Copy to .env for local development.
# NEVER commit real .env secrets to Git!

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Local Dev: leave default or unset to use Local JSON Persistence Store
# Production (Render): set to your free MongoDB Atlas connection string:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/postmate?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/postmate
USE_LOCAL_DB_FALLBACK=true

# Security & JWT Secrets (in Render production, set a long random secret)
JWT_SECRET=change_me_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# Post Office Default Information
DEFAULT_OFFICE_CODE=PO-600001
DEFAULT_OFFICE_NAME=Anna Nagar Sub Post Office
DEFAULT_OFFICE_TYPE=Town

# Frontend URLs (CORS Allowlist — set FRONTEND_URL on Render to your Vercel URL)
FRONTEND_URL=https://your-postmate-app.vercel.app
WEB_CLIENT_URL=http://localhost:5173
MOBILE_CLIENT_URL=http://localhost:8081

# Barcode & OCR Simulation Settings
ENABLE_OCR_SIMULATION=true
REQUIRE_VERIFICATION_STEP=true

# Logging Level
LOG_LEVEL=info
